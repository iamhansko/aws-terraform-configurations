# These outputs carry their value expressions directly rather than projecting a local.outputs map. That map
# keeps a root's outputs and a README written onto a VS Code instance in step, so it applies only to roots
# declaring module "vscode_ec2" (rules.md H-2). There is no instance here.
#
# The two order notes come first. They are the half of the cross-account procedure Terraform cannot enforce -
# depends_on does not reach across state files - so they are written into both roots' outputs rather than
# only into a README (rules.md I-4).
output "apply_order_note" {
  value       = "This root is step 3: 1) apply 1_destination_account with the destination account's credentials  2) copy its source_account_variables output into this root's variables  3) apply this root in account ${data.aws_caller_identity.current.account_id}"
  description = "Applying this root first fails: S3 validates a replication configuration when it is created, including that the destination bucket exists, and the bucket's name is generated by the other root"
}
output "teardown_order_note" {
  value       = "1) terraform destroy here, in account ${data.aws_caller_identity.current.account_id}  2) then terraform destroy in 1_destination_account with the destination account's credentials"
  description = "The exact reverse of the apply. Destroying the destination first leaves this root's replication rule pointing at a bucket that no longer exists, and every write here then records a FAILED replication status. force_destroy is on, so this deletes every object and every version in the source bucket (rules.md I-4)"
}
output "source_bucket_name" {
  value       = module.source_bucket.bucket_name
  description = "Generated name of the source bucket"
}
output "replication_role_arn" {
  value       = module.replication_role.role_arn
  description = "ARN of the role S3 assumes. Compare it against the destination root's replication_role_arn output - they have to be the same string, and nothing checks that for you. A mismatch fails neither apply; replication simply never happens"
}
output "destination_bucket_name" {
  value       = var.destination_bucket_name
  description = "The bucket in the other account this replicates into, re-exposed so the pairing is visible from either side (rules.md B-5)"
}
output "replication_rule_id" {
  value       = module.source_bucket.rule_id
  description = "Id of the replication rule, which is what appears in each object's replication status and in the CloudWatch metrics"
}
output "replication_time_control_enabled" {
  value       = module.source_bucket.replication_time_control_enabled
  description = "Whether RTC is on. Off by default here where the _monolithic template had it on, because it is billed per gigabyte replicated"
}
output "demo_object_keys" {
  value       = module.source_bucket.object_keys
  description = "Objects written into the source bucket by this apply. These are what should appear in the destination"
}
output "replication_status_command" {
  value       = module.source_bucket.replication_status_command
  description = "1. The replication status S3 recorded on the first demo object. PENDING then COMPLETED is the normal path. FAILED is the only place a wrong role or destination policy is reported - neither apply fails"
}
output "upload_command" {
  value       = module.source_bucket.upload_command
  description = "2. Writes a fresh object, for watching replication happen. Objects that existed before the rule was created are never replicated, so this is also how to test a rule added to an existing bucket"
}
output "check_destination_command" {
  value       = "aws s3api list-object-versions --bucket ${var.destination_bucket_name} --query 'Versions[].[LastModified,Key]' --output table"
  description = "3. What arrived. Run this with the destination account's credentials - these credentials cannot read that bucket, which is the correct outcome: only the replication role was granted access to it"
}
