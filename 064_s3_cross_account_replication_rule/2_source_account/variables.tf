variable "aws_region" {
  type        = string
  default     = null
  description = "Target AWS region. When null, falls back to the provider default chain (AWS_REGION, profile, etc.)"

  validation {
    condition     = var.aws_region == null || can(regex("^[a-z]{2}(-gov)?-[a-z]+-[0-9]$", var.aws_region))
    error_message = "aws_region must be a valid AWS region such as ap-northeast-2, or null to fall back to the provider default chain."
  }
}
variable "project_name" {
  type        = string
  default     = "s3-xacct-replication"
  description = "Base name for the bucket prefix. The same default as the destination root so the two are recognisably one project in two accounts. Short because S3 caps a bucket_prefix at 37 characters and this root appends \"-source-\" to it - the fuller \"s3-cross-account-replication\" overflows that, and the provider reports it as a range error on bucket_prefix rather than as anything to do with this variable"

  validation {
    # 24 rather than 63: the module appends "-source-" and S3 rejects a bucket_prefix over 37 characters
    # (rules.md B-1).
    condition     = can(regex("^[a-z0-9][a-z0-9-]{1,23}$", var.project_name))
    error_message = "project_name must be 2-24 characters of lowercase letters, digits and hyphens. The limit is 24 rather than 63 because this root appends \"-source-\" to it and S3 caps a bucket_prefix at 37 characters."
  }
}
variable "destination_bucket_name" {
  type        = string
  description = "Bucket in the destination account that objects are replicated into. No default: it is generated by the other root, so it cannot be known until that one has been applied. Read it from that root's destination_bucket_name output (rules.md I-1)"

  validation {
    condition     = can(regex("^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$", var.destination_bucket_name))
    error_message = "destination_bucket_name must be a valid S3 bucket name."
  }
}
variable "destination_account_id" {
  type        = string
  description = "Account that owns that bucket. S3 requires it on a cross-account rule - naming the bucket alone is not enough, which is what stops a rule being pointed at a stranger's bucket"

  validation {
    condition     = can(regex("^[0-9]{12}$", var.destination_account_id))
    error_message = "destination_account_id must be a 12-digit AWS account ID."
  }
}
variable "replication_role_name" {
  type        = string
  default     = "S3CrossAccountReplicationRole"
  description = <<-DESC
    Name of the role this root creates for S3 to assume.

    Fixed rather than generated, and it has to be the same string the destination root was given: that root's
    bucket policy derives this role ARN and matches it through aws:PrincipalArn, while the two state files
    cannot reference each other (rules.md I-2). Changing it means changing it on both sides and reapplying
    both.

    A mismatch does not fail either apply. Replication just never happens, and the reason appears only as a
    FAILED replication status on the objects.
  DESC

  validation {
    condition     = can(regex("^[a-zA-Z0-9+=,.@_-]{1,64}$", var.replication_role_name))
    error_message = "replication_role_name must be 1-64 characters from the set IAM accepts for a role name."
  }
}
variable "replicate_owner_override" {
  type        = bool
  default     = true
  description = "Whether to hand ownership of replicated objects to the destination account. Has to match allow_owner_override in the destination root. With it on, three things line up: the role is granted the action, the destination policy permits it, and the rule asks for the translation. With it off on either side, replicas stay owned by this account and the destination account cannot read its own bucket"
}
variable "replication_time_minutes" {
  type        = number
  default     = null
  description = "Replication Time Control target in minutes. The _monolithic template set 15, the only value S3 accepts. Null leaves RTC off, which is the default here because it is billed per gigabyte replicated on top of the transfer itself - set 15 to get the original's behaviour"

  validation {
    condition     = var.replication_time_minutes == null || var.replication_time_minutes == 15
    error_message = "replication_time_minutes must be 15, which is the only value S3 accepts, or null to leave Replication Time Control off."
  }
}
variable "replicate_delete_markers" {
  type        = bool
  default     = true
  description = "Whether a delete in the source places a delete marker in the destination, as the _monolithic template had it. It does not replicate a delete of a specific version - S3 never does - so this cannot be used to erase a replica"
}
variable "rule_prefix" {
  type        = string
  default     = ""
  description = "Key prefix the rule applies to. Empty replicates everything, as the _monolithic template had it"
  validation {
    # A leading slash is the usual mistake, and it matches nothing: S3 keys do not start with one, so the rule
    # is accepted and replicates no object at all. 1024 is S3's key length limit, expressed with length()
    # because RE2 rejects a {0,1024} quantifier.
    condition     = !startswith(var.rule_prefix, "/") && length(var.rule_prefix) <= 1024
    error_message = "rule_prefix must not start with a slash - S3 keys never do, so such a rule replicates nothing - and must be at most 1024 characters."
  }
}
variable "demo_objects" {
  type = map(string)
  default = {
    "demo/hello.txt" = "This object was written by Terraform into the source bucket and replicated across accounts.\n"
  }
  description = "Objects written into the source bucket so that there is something to replicate. The _monolithic template created two empty buckets and a rule, so nothing ever replicated and there was no way to tell whether the configuration worked. Set {} to get that back"

  validation {
    condition     = alltrue([for key in keys(var.demo_objects) : can(regex("^[^/]", key))])
    error_message = "demo_objects keys must not start with a slash."
  }
}
variable "force_destroy" {
  type        = bool
  default     = true
  description = "Whether terraform destroy empties the source bucket before deleting it. True, because the bucket holds the demo objects and anything uploaded by hand, and versioning - which S3 requires on a replication source - keeps every version of each, so a destroy would otherwise stop at BucketNotEmpty. It removes all versions, and none of it is recoverable (rules.md I-4)"
}
variable "expected_account_id" {
  type        = string
  default     = null
  description = "Account this root expects to be applied into. Null skips this check; the guard against the destination account's credentials runs regardless, because destination_account_id is required. Set it and a run in any other account fails in plan (rules.md I-2)"

  validation {
    condition     = var.expected_account_id == null || can(regex("^[0-9]{12}$", var.expected_account_id))
    error_message = "expected_account_id must be a 12-digit AWS account ID, or null to skip the check."
  }
}
variable "noncurrent_version_expiration_days" {
  type        = number
  default     = 30
  description = "How long a superseded version is kept in the source bucket. Versioning is mandatory on a replication source, so without a rule everything is retained forever. Set null to keep them all"

  validation {
    condition     = var.noncurrent_version_expiration_days == null || var.noncurrent_version_expiration_days >= 1
    error_message = "noncurrent_version_expiration_days must be at least 1, or null to keep every version."
  }
}
